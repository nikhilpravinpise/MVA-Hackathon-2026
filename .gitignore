# Python
.venv/
__pycache__/
*.pyc

# Patient data - NEVER commit (gated dataset, deletion required post-hackathon)
# data/* / results/* ignore contents but keep the retention manifests tracked.
data/*
!data/RETENTION.md
results/*
!results/RETENTION.md
local_dev/

# Everything under env/ is either re-fetchable public data or derived
# patient-adjacent products (reference FASTA, realigned BAMs, caches) -
# none of it belongs in git. Keep the manifest tracked.
env/*
!env/RETENTION.md

# Patient/reference artifacts that landed at repo ROOT (realign exports,
# reference FASTA duplicates, locus VCF slices). data/* env/* results/*
# are already covered; these patterns stop a bare `git add -A` from
# committing root-level genotype/reference files.
/*.bam
/*.bai
/*.sam
/*.vcf
/*.vcf.gz
/*.fna
/*.fna.fai
/*.fa
/*.fa.fai

# Secrets
.env
*.pem
*.key

# OS artifacts
nul
Thumbs.db
.DS_Store

# coverage artifacts
.coverage
coverage.xml
htmlcov/

# Foreign artifact - FedGRAA-v2 doc from a different project; kept on
# disk for reference but must never be committed to this repo
docs/COMPUTE_INFRASTRUCTURE_2026-07-27.md
.venv-t2/
